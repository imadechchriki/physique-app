# .env file for development
REACT_APP_API_BASE_URL=http://localhost:8080/api
REACT_APP_APP_NAME=PhysicsLab
REACT_APP_VERSION=1.0.0

# Security settings
REACT_APP_SECURE_COOKIES=false
REACT_APP_SAME_SITE=strict

# Optional: API timeouts (in milliseconds)
REACT_APP_API_TIMEOUT=30000
REACT_APP_REFRESH_TOKEN_BUFFER=300000

# Optional: Enable debug mode
REACT_APP_DEBUG=true

# Production environment variables (.env.production)
# REACT_APP_API_BASE_URL=https://your-production-api.com/api
# REACT_APP_SECURE_COOKIES=true
# REACT_APP_DEBUG=false
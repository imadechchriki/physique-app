# PhysicsLab Backend Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=physicslab_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# JWT Configuration
JWT_TOKEN=your_very_long_and_secure_jwt_secret_key_at_least_32_characters_long_change_this_in_production
JWT_ISSUER=PhysicsLabAPI
JWT_AUDIENCE=PhysicsLabClient

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_NAME=PhysicsLab
SMTP_FROM_EMAIL=noreply@physicslab.ma
SMTP_USE_SSL=false
SMTP_USE_TLS=true

# Application Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Token Expiration Settings (optional - will use defaults if not set)
TOKEN_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=24
TOKEN_CLEANUP_INTERVAL_HOURS=1

# Logging Level
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning
Logging__LogLevel__Microsoft.Hosting.Lifetime=Information

# Admin Default Password (change immediately after first login)
ADMIN_DEFAULT_PASSWORD=Admin@PhysicsLab2024